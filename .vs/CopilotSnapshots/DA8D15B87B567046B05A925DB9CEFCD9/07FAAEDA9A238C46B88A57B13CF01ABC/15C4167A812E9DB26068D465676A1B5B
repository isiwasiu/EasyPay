        public void GenerateKey()
        {
            using RSA rsa = RSA.Create(2048);
            // Export Private Key (PKCS#8)
            string privateKeyPem = rsa.ExportPkcs8PrivateKeyPem();
            // Export Public Key (X.509)
            string publicKeyPem = rsa.ExportSubjectPublicKeyInfoPem();

            string privatePath = Path.Combine(Directory.GetCurrentDirectory(),"privateKey.pem");
            string publicPath = Path.Combine(Directory.GetCurrentDirectory(), "publicKey.pem");

            File.WriteAllText(privatePath, privateKeyPem);
            File.WriteAllText(publicPath, publicKeyPem);
        }

        public string BeautifyXml(XmlDocument doc)
        {
            using (var stringWriter = new System.IO.StringWriter())
            using (var xmlTextWriter = new XmlTextWriter(stringWriter))
            {
                xmlTextWriter.Formatting = Formatting.Indented; // Pretty print
                doc.WriteTo(xmlTextWriter);
                return stringWriter.ToString();
            }
        }

        
