        public bool ValidateXmlSignature(XmlDocument doc, RSA publicKey)
        {
            // 1. Guard clauses: Ensure inputs are not null
            if (doc == null)
                throw new ArgumentNullException(nameof(doc));
            if (publicKey == null)
                throw new ArgumentNullException(nameof(publicKey));

            // 2. Locate the <Signature> element inside the XML
            XmlNodeList signatureNodes = doc.GetElementsByTagName("Signature", SignedXml.XmlDsigNamespaceUrl);
            if (signatureNodes == null || signatureNodes.Count == 0)
                throw new Exception("Cannot find Signature element");

            // 3. Create a SignedXml object and load the <Signature> element
            SignedXml signedXml = new SignedXml(doc);
            signedXml.LoadXml((XmlElement)signatureNodes[0]!);

            // 4. Validate the signature using the provided RSA public key
            bool isValid = signedXml.CheckSignature(publicKey);

            // 5. Return the validation result
            return isValid;
        }
        public void DebugSignature(XmlDocument doc, RSA publicKey)
        {
            doc.PreserveWhitespace = true;

            var signatureNode = doc.GetElementsByTagName(
                "Signature",
                SignedXml.XmlDsigNamespaceUrl
            )[0] as XmlElement;

            var signedXml = new SignedXml(doc);
            signedXml.LoadXml(signatureNode!);

            // 1️⃣ Check SignedInfo hash
            bool signedInfoValid = signedXml.CheckSignatureReturningKey(out _);
            Console.WriteLine($"SignedInfo valid: {signedInfoValid}");

            // 2️⃣ Recompute reference digest manually
            foreach (Reference reference in signedXml.SignedInfo!.References)
            {
                var calcDigest = reference.DigestValue;
                Console.WriteLine($"Reference digest length: {calcDigest!.Length}");
            }

            // 3️⃣ Raw signature crypto check
            bool cryptoValid = publicKey.VerifyData(
                signedXml.SignedInfo.GetXml().OuterXml is string si
                    ? System.Text.Encoding.UTF8.GetBytes(si)
                    : Array.Empty<byte>(),
                signedXml.SignatureValue!,
                HashAlgorithmName.SHA256,
                RSASignaturePadding.Pkcs1
            );

            Console.WriteLine($"Crypto valid: {cryptoValid}");
        }
        public string EncryptContent(XmlDocument signedDoc, string xpath, string NameSpace)
        {

            try
            {
                string encryptedContent = "";

                string publicPath = Path.Combine(Directory.GetCurrentDirectory(), _settings.publicKeyPath!);
                string publicKeyPem = File.ReadAllText(publicPath);

                RSA rsp = RSA.Create();
                rsp.ImportFromPem(publicKeyPem);

                if (signedDoc == null) throw new ArgumentNullException(nameof(signedDoc));
                if (rsp == null) throw new ArgumentNullException(nameof(rsp));


                //if (signedDoc == null)
                //    throw new ArgumentNullException(nameof(signedDoc),
                //        "signed XML document cannot be null — ensure signing completed before encryption");

                //if (rsp == null)
                //    throw new ArgumentNullException(nameof(rsp),
                //        "Encryption response object cannot be null — check NIBSS public key loaded correctly");



                //from chatGbt
                XmlNamespaceManager ns = new XmlNamespaceManager(signedDoc.NameTable);
                ns.AddNamespace(
                    "ns2",
                    NameSpace!
                );

                XPathNavigator navigator = signedDoc.CreateNavigator()!;
                XPathNodeIterator nodeList =
                    navigator.Select(xpath!, ns);

                while (nodeList.MoveNext())
                {
                    var currentNode = ((IHasXmlNode)nodeList.Current!).GetNode() as XmlElement;
                    if (currentNode == null) continue;

                    // STEP 2: Generate a random AES-256 session key
                    using (Aes aes = Aes.Create())
                    {
                        aes.KeySize = 256;

                        // STEP 3: Encrypt the XML element using the AES session key
                        var encryptedXml = new EncryptedXml();
                        byte[] encryptedElement = encryptedXml.EncryptData(currentNode, aes, content: true);

                        // STEP 4: Encrypt the AES session key using the provided RSA public key (RSA-OAEP)
                        byte[] encryptedKey = EncryptedXml.EncryptKey(aes.Key, rsp, useOAEP: true);

                        // STEP 5: Create the EncryptedData XML structure (for the element content)
                        EncryptedData edElement = new EncryptedData
                        {
                            Type = EncryptedXml.XmlEncElementContentUrl,
                            EncryptionMethod = new EncryptionMethod(EncryptedXml.XmlEncAES256Url)
                        };

                        // STEP 6: Wrap the encrypted session key in an EncryptedKey element
                        EncryptedKey ek = new EncryptedKey
                        {
                            CipherData = new CipherData(encryptedKey),
                            EncryptionMethod = new EncryptionMethod(EncryptedXml.XmlEncRSAOAEPUrl)
                        };

                        // STEP 7: Build KeyInfo to include the encrypted session key
                        KeyInfoName kin = new KeyInfoName { Value = "EncryptedKey" };
                        KeyInfo keyInfo = new KeyInfo();
                        keyInfo.AddClause(new KeyInfoEncryptedKey(ek));
                        edElement.KeyInfo = keyInfo;

                        // STEP 8: Attach the encrypted element data
                        edElement.CipherData.CipherValue = encryptedElement;

                        // STEP 9: Replace the original XML element with the EncryptedData element
                        EncryptedXml.ReplaceElement(currentNode, edElement, content: true);

                        encryptedContent = ApplicationConstant.startXml + currentNode.ParentNode!.OuterXml;
                    }

                }

                return encryptedContent;

            }
            catch (Exception ex)
            {
                _logger.LogInformation("An exception occur during encryption with message {@message}", ex.Message);
                return string.Empty;
            }
        }


