        public async Task<CustomResult<Pain010Response>> ProcessPain010(Pain010Request payload)
        {
            Pain010Response response = new();
            StringBuilder error = new StringBuilder();
            payload.MessageId = NumericMsgIdGenerator.Generate(_settings.InstitutionCode!);
            payload.CreateAt = NumericMsgIdGenerator.GetIsoTime();
            payload.MandateTrackingIndicator = ApplicationConstant.TrackingIndicator;
            payload.MandateNameSpace = ApplicationConstant.MandateNameSpace;


            _logger.LogInformation("\r\n Outward ain010 API Request ===> \r\n {@req} \rn\n with message id {@msgid} \r\n  ", JsonSerializer.Serialize(payload), payload.MessageId);

            //validating the request
            var validators = new Pain010Validators();
            var validationResult = await validators.ValidateAsync(payload);

            if (validationResult.IsValid == false)
            {
                foreach (var item in validationResult.Errors)
                {
                    error.Append(item);
                }

                _logger.LogError("Validation error with message {@message}", error.ToString());

                return CustomResult<Pain010Response>.Failure(CustomError.ValidationError(error.ToString()));
            }

            Pain010Document document = RegeneratePain010(payload);

            //serialize to xml
            string xmlDocument = SerializePayload<Pain010Document>(document, ApplicationConstant.pain010);
            xmlDocument = Regex.Unescape(xmlDocument);


            //convert to XMLDocument
            XmlDocument xmlDoc = ConvertXmlToDoc(xmlDocument);

            _logger.LogInformation("\r\n UnEncrypted Outward Pain010 xml request ==> \r\n {@req} \r\n  with MessageId ==>{@messg} \r\n ", xmlDoc.OuterXml,
               payload.MessageId);

       
           



            //signed the 
            await Task.Run(() => SignXmlDocument(xmlDoc));

            _logger.LogInformation("Signed pain010 xml request ==> {@req} with messageId =>{@messg}",
                xmlDoc.OuterXml, payload.MessageId);


            string path = _settings.Pain010Path! + "//" + $"UnEncryptedOutwardPain010_{payload.MessageId}.xml";

            // Get the directory portion of the path
            string? directory = Path.GetDirectoryName(path);
            if (!string.IsNullOrEmpty(directory))
            {
                Directory.CreateDirectory(directory); // Creates the directory (and any missing subdirectories)
            }

            // Now write the file
            NumericMsgIdGenerator.WriteToFile(path, xmlDoc.OuterXml);



            string encryptedContent = EncryptContent(xmlDoc, _settings.Pain010EncrypPath!, ApplicationConstant.pain010);

            _logger.LogInformation("encrypted Outward pain010 xml request ==> {@req} with messageId =>{@messg}",
                encryptedContent, payload.MessageId);

            string path1 = _settings.Pain010Path! + "//" + $"EncryptedOutwardPain010_{payload.MessageId}.xml";

            // Get the directory portion of the path
            string? directory1 = Path.GetDirectoryName(path1);
            if (!string.IsNullOrEmpty(directory1))
            {
                Directory.CreateDirectory(directory1); // Creates the directory (and any missing subdirectories)
            }

            // Now write the file
            NumericMsgIdGenerator.WriteToFile(path1, encryptedContent);


            //send to nibss
            var NpsResponse = await SendRequestToNibss(encryptedContent, _settings.BaseUrl!, _settings.PainUrl!);

            if (!NpsResponse.succeeded)
            {
                string? failedMessage = "Failed messsage returned from NPS switch  iro Outward Pain010: " + NpsResponse.message;
                return CustomResult<Pain010Response>.Failure(CustomError.BadRequestError(failedMessage));
            }

            _logger.LogInformation("Got a successful response from NPS endpoint iro Outward Pain010");

            response.encryptedResponse = "Got a successful response from NPS endpoint";
            return CustomResult<Pain010Response>.Success(response, ApplicationConstant.successMessage);
        }
