        public string SerializePayload<T>(T payload, string nameSpace)
        {

            var ns = new XmlSerializerNamespaces();
            ns.Add("ns2", nameSpace);

            var serializer = new XmlSerializer(typeof(T));
            var settings = new XmlWriterSettings
            {
                Encoding = new UTF8Encoding(false),
                Indent = true,
                OmitXmlDeclaration = true // We'll write it manually
            };

            using (var stream = new MemoryStream())
            using (var writer = XmlWriter.Create(stream, settings))
            {
                // Write custom XML declaration
                writer.WriteStartDocument(true); // standalone="no"
                serializer.Serialize(writer, payload, ns);
                writer.Flush();

                string pp = Encoding.UTF8.GetString(stream.ToArray());
                string xml = ApplicationConstant.startXml +
                             Encoding.UTF8.GetString(stream.ToArray());

                return xml;
            }

        }
        public T DeserializePayload<T>(string xmlString)
        {
