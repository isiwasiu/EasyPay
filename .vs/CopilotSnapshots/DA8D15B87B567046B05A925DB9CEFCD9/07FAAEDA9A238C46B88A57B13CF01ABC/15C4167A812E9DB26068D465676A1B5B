        public string GetXPath(XmlNode node)
        {
            if (node == null) return string.Empty;

            if (node.NodeType == XmlNodeType.Attribute)
                return $"{GetXPath(((XmlAttribute)node).OwnerElement!)}/@{node.Name}";

            if (node.ParentNode == null)
                return "/" + node.Name;

            return GetXPath(node.ParentNode) + "/" + node.Name;
        }
        public void SignXmlDocument(XmlDocument doc)
        {
            string privatePath = Path.Combine(Directory.GetCurrentDirectory(), _settings.privateKeyPath!);

          string privateKeyPem = File.ReadAllText(privatePath);

            RSA rs = RSA.Create();
            rs.ImportFromPem(privateKeyPem);

            if (doc == null)
                throw new ArgumentNullException(nameof(doc));
            if (rs == null)
                throw new ArgumentNullException(nameof(rs));

            // 1. Create a SignedXml object
            SignedXml signedXml = new SignedXml(doc)
            {
                SigningKey = rs
            };

            // 2. Create a reference to the enveloped XML
            Reference reference = new Reference(string.Empty)
            {
                DigestMethod = SignedXml.XmlDsigSHA256Url
            };

            // 3. Add the enveloped transform
            reference.AddTransform(new XmlDsigEnvelopedSignatureTransform());

            // 4. Add the reference to the SignedXml object
            signedXml.AddReference(reference);

            // 5. Set canonicalization method (C14N)
            //signedXml.SignedInfo!.CanonicalizationMethod = SignedXml.XmlDsigExcC14NTransformUrl;

            signedXml.SignedInfo!.CanonicalizationMethod = SignedXml.XmlDsigCanonicalizationUrl;

            // 6. Set the signature method to RSA-SHA256
            signedXml.SignedInfo.SignatureMethod =
                "http://www.w3.org/2001/04/xmldsig-more#rsa-sha256";

            // 7. Compute the signature
            signedXml.ComputeSignature();

            // 8. Get the XML representation of the signature
            XmlElement xmlDigitalSignature = signedXml.GetXml();

            // 9. Append the signature to the root element
            doc.DocumentElement!.AppendChild(doc.ImportNode(xmlDigitalSignature, true));

        }
        public void DecryptXmlElement(XmlDocument doc, string xpathExpression)
        {
            //read all the keys
            string privatePath = Path.Combine(Directory.GetCurrentDirectory(), _settings.privateKeyPath!);
            string privateKeyPem = File.ReadAllText(privatePath);

            RSA rs = RSA.Create();
            rs.ImportFromPem(privateKeyPem);


            if (doc == null) throw new ArgumentNullException(nameof(doc));
            if (rs == null) throw new ArgumentNullException(nameof(rs));

            // STEP 1: Setup XML namespace manager for encrypted XML
            XmlNamespaceManager nsMgr = new XmlNamespaceManager(doc.NameTable);
            nsMgr.AddNamespace("xenc", EncryptedXml.XmlEncNamespaceUrl);

            // STEP 2: Locate EncryptedData nodes using XPath
            XmlNodeList encDataNodes = doc.SelectNodes(xpathExpression, nsMgr)!;
            if (encDataNodes == null || encDataNodes.Count == 0)
                throw new Exception("No EncryptedData nodes found.");

            foreach (XmlElement encryptedElement in encDataNodes)
            {
                // STEP 3: Load the <EncryptedData> element
                EncryptedData encryptedData = new EncryptedData();
                encryptedData.LoadXml(encryptedElement);

                // STEP 4: Extract <EncryptedKey> from KeyInfo
                if (encryptedData.KeyInfo == null || encryptedData.KeyInfo.Count == 0)
                    throw new CryptographicException("No KeyInfo found in EncryptedData.");

                EncryptedKey? encryptedKey = null;
                foreach (KeyInfoClause clause in encryptedData.KeyInfo)
                {
                    if (clause is KeyInfoEncryptedKey keyClause)
                    {
                        encryptedKey = keyClause.EncryptedKey!;
                        break;
                    }
                }
                if (encryptedKey == null)
                    throw new CryptographicException("EncryptedKey not found inside KeyInfo.");

                // STEP 5: Decrypt AES session key with RSA private key
                byte[] sessionKey = EncryptedXml.DecryptKey(
                    encryptedKey.CipherData.CipherValue!,
                    rs,
                    useOAEP: true
                );

                // STEP 6: Use AES session key to decrypt the XML data
                using (Aes aesAlg = Aes.Create())
                {
                    aesAlg.Key = sessionKey;
                    EncryptedXml exml = new EncryptedXml();
                    byte[] decryptedData = exml.DecryptData(encryptedData, aesAlg);

                    // STEP 7: Replace the encrypted XML content with decrypted plaintext
                    exml.ReplaceData(encryptedElement, decryptedData);
                }
            }
        }


