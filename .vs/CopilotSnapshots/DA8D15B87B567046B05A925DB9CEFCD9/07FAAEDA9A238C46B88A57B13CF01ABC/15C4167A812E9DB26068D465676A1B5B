        public async Task<CustomResult<Acmt023Response>> ProcessAcmt023(AccountVerificationRequest accountVerificationRequest)
        {
            Acmt023Response response = new();
            StringBuilder error = new StringBuilder();
            ActivitiesLog activitiesLog = new ActivitiesLog();


            var userId = _httpContextAccessor.HttpContext?.Items["UserId"] as string ?? "ANONYMOUS"; 
         //   var apiKey = _httpContextAccessor.HttpContext?.Items["ApiKey"] as string;  
           // var clientId = _httpContextAccessor.HttpContext?.Items["ClientId"] as string
                   


            var userAgent = _httpContextAccessor.HttpContext?.Request.Headers["User-Agent"].ToString();
            var requestPath = _httpContextAccessor.HttpContext?.Request.Path;
            var queryString = _httpContextAccessor.HttpContext?.Request.QueryString;
            var method = _httpContextAccessor.HttpContext?.Request.Method;
            var clientIp = GetClientIpAddress(_httpContextAccessor.HttpContext);

            activitiesLog.ClientId = userId;
            activitiesLog.clientIpAddress = clientIp;
            activitiesLog.UserAgent = userAgent;
            activitiesLog.RequestCategory = method;
            activitiesLog.Direction = DircetionConstant.Outward;

            string rawId = NumericMsgIdGenerator.Generate(_settings.InstitutionCode!);
            string messageId = rawId.PadLeft(35, '0').Substring(0, 35);

            accountVerificationRequest.MessageId = messageId;
            activitiesLog.MessageId = messageId;
            accountVerificationRequest.CreatedAt = NumericMsgIdGenerator.GetIsoTime();
            activitiesLog.RequestDateTime = NumericMsgIdGenerator.GetIsoTime();
            accountVerificationRequest.VerifyID = messageId;

            _logger.LogInformation("\r\n <========   API Request Outword  Acmt 023   ======> \r\r {@req}  \r \n", JsonSerializer.Serialize(accountVerificationRequest));
            activitiesLog.Request = JsonSerializer.Serialize(accountVerificationRequest);

            // Validation
            var validators = new Acmt023Validators();
            var validationResult = await validators.ValidateAsync(accountVerificationRequest);
            if (!validationResult.IsValid)
            {
                foreach (var item in validationResult.Errors)
                    error.Append(item);

                _logger.LogError(" \r \n <====== Validation error with message  ==========> \r\n {@message}  \r\n", error.ToString());
                return CustomResult<Acmt023Response>.Failure(CustomError.ValidationError(error.ToString()));
            }

            acmt023Document document = RegenerateAcm023(accountVerificationRequest);
            string xmlDocument = SerializePayload<acmt023Document>(document, ApplicationConstant.camt023);

            _logger.LogInformation("\r\n <==========  UnEncrypted acmt023  xml request =========> \r\n {@req}  \r\n with MessageId ==>{@messg}\r\n", xmlDocument, accountVerificationRequest.MessageId);

            activitiesLog.Request = xmlDocument;

            XmlDocument xmlDoc = ConvertXmlToDoc(xmlDocument);
            await Task.Run(() => SignXmlDocument(xmlDoc));

            _logger.LogInformation("\r\n <======= Signed  acmt023 xml request ==> \r\n {@req} \r\n with messageId =>{@messg} \r\n", xmlDoc.OuterXml, accountVerificationRequest.MessageId);
            activitiesLog.RequestWithSignature = xmlDoc.OuterXml;

            string path = _settings.Acmt023Path! + "//" + $"OutwardSignedAcmt023_{messageId}.xml";
            string? directory = Path.GetDirectoryName(path);
            if (!string.IsNullOrEmpty(directory))
                Directory.CreateDirectory(directory);
            NumericMsgIdGenerator.WriteToFile(path, xmlDoc.OuterXml);

            string encryptedContent = EncryptContent(xmlDoc, _settings.Acmt023EncrypPath!, ApplicationConstant.camt023);

            _logger.LogInformation("\r\n <=======  encrypted   acmt023 xml request =====> \r\n  {@req}  \r\nwith messageId =====> \r\n {@messg}", encryptedContent, accountVerificationRequest.MessageId);
            activitiesLog.EncryptedRequest = encryptedContent;

            string path1 = _settings.Acmt023Path! + "//" + $"OutwardEncrypAcmt023_{messageId}.xml";
            string? directory1 = Path.GetDirectoryName(path);
            if (!string.IsNullOrEmpty(directory1))
                Directory.CreateDirectory(directory1);
            NumericMsgIdGenerator.WriteToFile(path1, encryptedContent);

            // Send to NIBSS
            activitiesLog.Endpoint = ApplicationConstant.camt023;
            activitiesLog.Baseurl = _settings.BaseUrl + _settings.AcmtUrl; 

            try
            {
                var NpsResponse = await SendRequestToNibss(encryptedContent, _settings.BaseUrl!, _settings.AcmtUrl!);

                if (!NpsResponse.succeeded)
                {
                    string? failedMessage = "Failed messsage returned from NPS switch";
                    activitiesLog.Status = "Failed";
                    activitiesLog.Response = failedMessage;
                    activitiesLog.ResponseDateTime = DateTimeOffset.UtcNow;
                    _nPSDBContext.ActivitiesLog.Add(activitiesLog);
                    try
                    {
                        await _nPSDBContext.SaveChangesAsync();
                    }
                    catch (Exception ex)
                    {
                        _logger.LogInformation("Table Save Error ==> {mesg}", ex.Message);
                    }
                    return CustomResult<Acmt023Response>.Failure(CustomError.BadRequestError(failedMessage));
                }

                // Success
                _logger.LogInformation("\r\n Got a successful  acmt023 response from NPS endpoint \r\n");
                response.MessageId = accountVerificationRequest.MessageId;
                activitiesLog.Status = "Success";
                activitiesLog.Response = NpsResponse.message;
                activitiesLog.ResponseDateTime = DateTimeOffset.UtcNow;
                await _nPSDBContext.ActivitiesLog.AddAsync(activitiesLog);

                try
                {
                    await _nPSDBContext.SaveChangesAsync();
                    _logger.LogInformation("Table Save Success ==> {mesg}", response.ToString());
                    return CustomResult<Acmt023Response>.Success(response, ApplicationConstant.NpsSuccessMessage);
                }
                catch (Exception ex)
                {
                    _logger.LogInformation("Table Save Error ==> {mesg}", ex.Message);
                    return CustomResult<Acmt023Response>.Failure(CustomError.BadRequestError("Data Insertion Failure"));
                }
            }
            catch (Exception ex)
            {
                response.MessageId = accountVerificationRequest.MessageId;
                activitiesLog.Status = "Failed";
                activitiesLog.Response = ex.Message.ToString(); // duplicate line removed in fix
                activitiesLog.ResponseDateTime = DateTimeOffset.UtcNow;
                await _nPSDBContext.ActivitiesLog.AddAsync(activitiesLog);
                try
                {
                    await _nPSDBContext.SaveChangesAsync();
                    _logger.LogInformation("Table Save Error message ==> {mesg}", ex.Message.ToString());
                }
                catch (Exception ex1)
                {
                    _logger.LogInformation("Table Save Error ==> {mesg}", ex1.Message);
                }
                return CustomResult<Acmt023Response>.Failure(CustomError.BadRequestError(ex.Message));
            }

            // ================ FIX: added final return to satisfy compiler ================
            return CustomResult<Acmt023Response>.Failure(CustomError.BadRequestError("Unexpected error"));
        }



