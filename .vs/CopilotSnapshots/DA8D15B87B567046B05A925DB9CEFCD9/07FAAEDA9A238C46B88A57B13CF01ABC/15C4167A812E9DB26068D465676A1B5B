        public async Task<CustomResult<Pacs008Response>> ProcessPacs008(CreditTransferRequest payload)
        {

            string rawId = NumericMsgIdGenerator.Generate(_settings.InstitutionCode!);
            string messageId = rawId.PadLeft(35, '0').Substring(0, 35); // always 35 chars


            Pacs008Response response = new();
            StringBuilder error = new StringBuilder();

            _logger.LogInformation("\r\n <=======     Outward Pacs008 API Request ===> \r\n {@req} \r\n ", JsonSerializer.Serialize(payload));

            //validating the request
            var validators = new Pacs008Validator();
            var validationResult = await validators.ValidateAsync(payload);

            if (validationResult.IsValid == false)
            {
                foreach (var item in validationResult.Errors)
                {
                    error.Append(item);
                }

                _logger.LogError("\r\n <========Validation error with message for Outward  Pacs008 \r\n  {@message}  \r\n", error.ToString());

                return CustomResult<Pacs008Response>.Failure(CustomError.ValidationError(error.ToString()));
            }

            Documents document = RegeneratePacs008(payload, messageId);

            //serialize to xml 
            string xmlDocument = SerializePayload<Documents>(document,ApplicationConstant.pacs008);
            xmlDocument = Regex.Unescape(xmlDocument);

            
            //convert to XMLDocument
            XmlDocument xmlDoc = ConvertXmlToDoc(xmlDocument);

       

            _logger.LogInformation("\r\n <==========    UnEncrypted Outward Pacs008 xml request =========> \r\n {@req} \t\n  with MessageId ==>{@messg}", xmlDoc.OuterXml,messageId);
           




            //signed the 
            await Task.Run(()=>SignXmlDocument(xmlDoc));

            _logger.LogInformation("\r\n <========  Signed Outward pacs008 xml request ======> \r\n  {@req}  \r\n with messageId =>{@messg}",
                xmlDoc.OuterXml, messageId);

            string path = _settings.Pacs008Path! + "//" + $"OutwardSignedPacs008_{messageId}.xml";

            // Get the directory portion of the path
            string? directory = Path.GetDirectoryName(path);
            if (!string.IsNullOrEmpty(directory))
            {
                Directory.CreateDirectory(directory); // Creates the directory (and any missing subdirectories)
            }

            // Now write the file
            NumericMsgIdGenerator.WriteToFile(path, xmlDoc.OuterXml);






            string encryptedContent = EncryptContent(xmlDoc, _settings.Pacs008EncrypPath!, ApplicationConstant.pacs008);

            _logger.LogInformation("\r\n <==========   Encrypted Outward  pacs008 xml request =========> \r\n {@req}\r\n  with messageId =>{@messg}",
                encryptedContent, messageId);


            string path1 = _settings.Pain009Path! + "//" + $"OutwardEncryptedPacs008_{messageId}.xml";

            // Get the directory portion of the path
            string? directory1 = Path.GetDirectoryName(path1);
            if (!string.IsNullOrEmpty(directory1))
            {
                Directory.CreateDirectory(directory1); // Creates the directory (and any missing subdirectories)
            }

            // Now write the file
            NumericMsgIdGenerator.WriteToFile(path, encryptedContent);







            //send to nibss
            var NpsResponse = await SendRequestToNibss(encryptedContent, _settings.BaseUrl!, _settings.PacsUrl!);

            if (!NpsResponse.succeeded)
            {
                string? failedMessage = "Failed messsage returned from NPS switch : "  +  NpsResponse.message; ;



                return CustomResult<Pacs008Response>.Failure(CustomError.BadRequestError(failedMessage));
            }

            _logger.LogInformation("\r\n Got a successful response from NPS endpoint \r\n ");

            response.encryptedResponse = "Got a successful response from NPS endpoint";
            return CustomResult<Pacs008Response>.Success(response, ApplicationConstant.successMessage);
        }
